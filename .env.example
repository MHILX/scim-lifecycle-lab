# Copy this file to .env for local development. Do not commit real credentials.
SCIM_HOST=127.0.0.1
SCIM_PORT=3000
SCIM_BASE_URL=http://127.0.0.1:3000
SCIM_DATABASE_PATH=./data/scim-lifecycle-lab.sqlite
SCIM_BEARER_TOKEN=replace-with-a-local-development-token
# Plain HTTP is allowed only on loopback. Set true behind a TLS-terminating proxy.
SCIM_ENFORCE_HTTPS=false
# Comma-separated trusted proxy IPs/CIDRs; blank means no forwarding headers are trusted.
SCIM_TRUST_PROXY=
SCIM_LOG_LEVEL=info
SCIM_ENABLE_INSPECTION=true
SCIM_AUDIT_REDACT_ATTRIBUTES=password,token,secret,authorization
# Optional: makes the simulator provision Alice with this Auth0 subject as externalId.
SCIM_AUTH0_SUBJECT=

# Demo application. DEMO_APP_BASE_URL must match AUTH0_CALLBACK_URL and AUTH0_LOGOUT_URL.
DEMO_APP_HOST=127.0.0.1
DEMO_APP_PORT=3001
DEMO_APP_BASE_URL=http://localhost:3001

# Auth0 Regular Web Application credentials. AUTH0_DOMAIN has no protocol.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AUTH0_CALLBACK_URL=http://localhost:3001/callback
AUTH0_LOGOUT_URL=http://localhost:3001

# Optional SCIM-to-Auth0 sync. Use a separate M2M application with update:users only.
# The management tenant must match the demo login tenant; domain has no protocol.
AUTH0_SYNC_ENABLED=false
AUTH0_MANAGEMENT_DOMAIN=your-tenant.us.auth0.com
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
